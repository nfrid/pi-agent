{
  "name": "@pi-dashboard/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pi-runtime-protocol": {
      "types": "./src/pi-runtime-protocol.ts",
      "default": "./dist/pi-runtime-protocol.js"
    },
    "./orchestration-contracts": {
      "types": "./src/orchestration-contracts.ts",
      "default": "./dist/orchestration-contracts.js"
    },
    "./dashboard-api": {
      "types": "./src/dashboard-api.ts",
      "default": "./dist/dashboard-api.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pi-dashboard/extension-contributions": "workspace:*"
  }
}
