{
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@pi-dashboard/extension-contributions": [
        "packages/extension-contributions/src/index.ts"
      ]
    },
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "packages/dashboard-protocol/src/**/*.ts",
    "packages/dashboard-domain/src/**/*.ts",
    "packages/dashboard-client/src/**/*.ts",
    "packages/activity-model/src/**/*.ts",
    "packages/codex-usage/src/**/*.ts",
    "apps/dashboard-server/src/**/*.ts"
  ],
  "exclude": ["apps/dashboard-web/**", "**/dist/**"]
}
