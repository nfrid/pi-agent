# Copy this file to .env.dashboard. The real file is intentionally ignored.
PI_DASHBOARD_HOST=127.0.0.1
PI_DASHBOARD_PORT=4173
PI_DASHBOARD_WEB_PORT=4174
PI_DASHBOARD_AUTH_TOKEN=replace-with-a-long-random-token
PI_DASHBOARD_ORIGINS=http://127.0.0.1:4174
VITE_DASHBOARD_URL=http://127.0.0.1:4173

# Optional overrides:
# VITE_DASHBOARD_LAN_URL=https://lan.example.com
# PI_DASHBOARD_STATE_DIR=/Users/you/.pi/agent/dashboard
# PI_SESSION_DIR=/Users/you/.pi/agent/sessions
# Stable runtime-host sidecar socket (defaults under PI_DASHBOARD_STATE_DIR):
# PI_DASHBOARD_RUNTIME_HOST_SOCKET=/Users/you/.pi/agent/dashboard/runtime-host.sock
# Owner-only durable shell-job socket (separate process-host sidecar):
# PI_PROCESS_HOST_SOCKET=/Users/you/.pi/agent/dashboard/background-jobs.sock
# PI_DASHBOARD_VAPID_PUBLIC_KEY=
# PI_DASHBOARD_VAPID_PRIVATE_KEY=
# PI_DASHBOARD_VAPID_SUBJECT=mailto:you@example.com
