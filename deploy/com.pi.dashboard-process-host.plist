<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pi.dashboard-process-host</string>
  <key>WorkingDirectory</key><string>/Users/REPLACE_ME/.pi/agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>apps/dashboard-server/dist/process-host-main.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PI_DASHBOARD_STATE_DIR</key><string>/Users/REPLACE_ME/.pi/agent/dashboard</string>
    <key>PI_PROCESS_HOST_SOCKET</key><string>/Users/REPLACE_ME/.pi/agent/dashboard/background-jobs.sock</string>
    <key>PATH</key><string>/Users/REPLACE_ME/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Users/REPLACE_ME/.pi/agent/dashboard/process-host.log</string>
  <key>StandardErrorPath</key><string>/Users/REPLACE_ME/.pi/agent/dashboard/process-host.error.log</string>
</dict>
</plist>
