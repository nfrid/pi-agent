{
  "name": "@pi-dashboard/server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=25"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./trpc": {
      "types": "./src/trpc.ts",
      "default": "./dist/trpc.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-client": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@pi-dashboard/activity-model": "workspace:*",
    "@pi-dashboard/codex-usage": "workspace:*",
    "@pi-dashboard/domain": "workspace:*",
    "@pi-dashboard/extension-contributions": "workspace:*",
    "@pi-dashboard/protocol": "workspace:*",
    "@pi-dashboard/worktree-manager": "workspace:*",
    "@trpc/server": "11.18.0",
    "fastify": "5.11.2",
    "typebox": "1.3.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@trpc/client": "11.18.0",
    "eventsource": "5.1.0",
    "tsx": "^4.23.4"
  }
}
